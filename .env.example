# Server
PORT=3000

# SharePoint Integration (optional — attachments work locally without this)
# To enable automatic sync of attachments to SharePoint:
#
# 1. Register an app in Azure AD (portal.azure.com > App registrations)
# 2. Grant it "Sites.ReadWrite.All" application permission in Microsoft Graph
# 3. Create a client secret
# 4. Fill in the values below
#
SHAREPOINT_TENANT_ID=your-azure-tenant-id
SHAREPOINT_CLIENT_ID=your-app-client-id
SHAREPOINT_CLIENT_SECRET=your-app-client-secret
SHAREPOINT_SITE_URL=https://yourcompany.sharepoint.com/sites/ACOMS
# SHAREPOINT_DRIVE_ID=        # Optional — uses default document library if not set
# SHAREPOINT_ROOT_FOLDER=Work Orders   # Folder name in the document library

# ServiceM8 Integration (required for job creation on approval)
# Jobs are created in ServiceM8 when a work order is approved.
# Uses HTTP Basic Auth — your email + API key.
#
# To get your API key: ServiceM8 > Settings > API & Webhooks
#
SERVICEM8_USERNAME=your-email@company.com
SERVICEM8_API_KEY=your-servicem8-api-key
# SERVICEM8_API_URL=https://api.servicem8.com/api_1.0   # Default, rarely needs changing

# BYDA / DBYD Integration (optional — works in manual mode without API keys)
# Automates Dial Before You Dig enquiry lodgement for excavation/civil jobs.
#
# Without these keys, the system still provides:
# - Automatic assessment of whether BYDA is required (via rules engine)
# - Map-based polygon drawing and storage
# - Manual lodge workflow with copy/paste of enquiry details
#
# To enable automatic API lodgement via SmarterWX:
#
# BYDA_PROVIDER=smarterwx
# BYDA_API_URL=https://api.smarterwx.com/v1
# BYDA_CLIENT_ID=your-smarterwx-client-id
# BYDA_CLIENT_SECRET=your-smarterwx-client-secret
# BYDA_API_KEY=your-smarterwx-api-key   # Alternative to client ID/secret
# BYDA_AUTO_LODGE=true                  # Auto-lodge when job is created (default: false)
# BYDA_EXPIRY_DAYS=28                   # Days until enquiry expires (default: 28)
# BYDA_REUSE_OVERLAP=70                 # Min polygon overlap % for reuse (default: 70)
